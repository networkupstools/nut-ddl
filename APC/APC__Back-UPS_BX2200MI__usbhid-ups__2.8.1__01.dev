# DEVICE:URL:VENDOR: https://www.se.com/uk/en/product/BX2200MI/apc-backups-2200va-tower-230v-6x-iec-c13-outlets-avr/

# DEVICE:COMMENT:
# APC Back-UPS BX2200MI (230V, 1200 W) on Debian 13 (trixie), NUT 2.8.1 from
# the Debian packages (2.8.1-5). Device dump generated by nut-ddl-dump.sh on
# Thu, 12 Nov 2026 09:24:51 +0300. Serial numbers are masked.
#
# In daily use since Aug 2026: OL/OB switching (incl. a real outage), charge,
# runtime, load, input voltage and the battery self-test all work.
# There's no temperature, `output.voltage` or `ups.firmware` variable.
#
# `battery.charge.low` and `battery.runtime.low` below are overrides from
# `ups.conf`; the device's own values are 10 and 120.
#
# Known quirks with this NUT version:
#
# * A few times a day `ups.status` flips to `OL RB` (sometimes `OL LB` with
#   `battery.charge: 0`) for one reading while the other values stay normal,
#   same as https://github.com/networkupstools/nut/issues/2347 and
#   https://github.com/networkupstools/nut/issues/3623.
# * Since 21 Aug 2026 the driver logs an I/O error every ~32 s, i.e. once
#   per full poll (see the log block below). It survived host reboots and a
#   UPS power cycle. Readings and OB detection aren't affected.
# DEVICE:EOC

# DEVICE:COMMENT-BLOCK:UPSCONF:
# [apc]
#     driver = "usbhid-ups"
#     port = "auto"
#     vendorid = "051D"
#     productid = "0002"
#     serial = "XXXXXXXXXXXX"
#     ignorelb
#     override.battery.runtime.low = 300
#     override.battery.charge.low = 20
# DEVICE:EOC

# DEVICE:COMMENT-BLOCK:LSUSB: lsusb
# ID 051d:0002 American Power Conversion Uninterruptible Power Supply
# DEVICE:EOC

# DEVICE:COMMENT-BLOCK:LOGS: journalctl -u nut-driver@apc, last hour, counted
#     106 nut_libusb_get_report: Input/Output Error
# DEVICE:EOC

# :; upsc apc@localhost
battery.charge: 100
battery.charge.low: 20
battery.mfr.date: 2026/08/14
battery.runtime: 3816
battery.runtime.low: 300
battery.type: PbAc
battery.voltage: 27.2
battery.voltage.nominal: 24.0
device.mfr: American Power Conversion
device.model: Back-UPS BX2200MI
device.serial: XXXXXXXXXXXX
device.type: ups
driver.debug: 0
driver.flag.allow_killpower: 0
driver.flag.ignorelb: enabled
driver.name: usbhid-ups
driver.parameter.override.battery.charge.low: 20
driver.parameter.override.battery.runtime.low: 300
driver.parameter.pollfreq: 30
driver.parameter.pollinterval: 2
driver.parameter.port: auto
driver.parameter.productid: 0002
driver.parameter.serial: XXXXXXXXXXXX
driver.parameter.synchronous: auto
driver.parameter.vendorid: 051D
driver.state: updateinfo
driver.version: 2.8.1
driver.version.data: APC HID 0.100
driver.version.internal: 0.52
driver.version.usb: libusb-1.0.28 (API: 0x100010a)
input.sensitivity: medium
input.transfer.high: 295
input.transfer.low: 145
input.voltage: 228.0
input.voltage.nominal: 230
ups.beeper.status: disabled
ups.delay.shutdown: 20
ups.load: 5
ups.mfr: American Power Conversion
ups.mfr.date: 2026/01/31
ups.model: Back-UPS BX2200MI
ups.productid: 0002
ups.realpower.nominal: 1200
ups.serial: XXXXXXXXXXXX
ups.status: OL
ups.test.result: Done and passed
ups.timer.reboot: 0
ups.timer.shutdown: -1
ups.vendorid: 051d

